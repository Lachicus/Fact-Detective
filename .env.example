# --- Store backend -------------------------------------------------------
# "firebase" for production, "memory" for local dev/tests.
# If unset it auto-detects: firebase when a database URL + credentials exist.
PFD_STORE=

# --- Firebase Realtime Database (Admin SDK, server-side) -----------------
FIREBASE_DATABASE_URL=https://YOUR-PROJECT-default-rtdb.firebaseio.com
# Service account JSON as a SINGLE-LINE string (paste the whole file, compact).
FIREBASE_SERVICE_ACCOUNT=
# Alternative to FIREBASE_SERVICE_ACCOUNT: path to a credentials file.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Firebase Web config (public; sent to the browser for RTDB reads) ----
# Only databaseURL is strictly required for reading the revision counter.
FIREBASE_WEB_CONFIG={"databaseURL":"https://YOUR-PROJECT-default-rtdb.firebaseio.com"}

# --- Misc ----------------------------------------------------------------
# Set to 1 on HTTPS (Vercel) so the session cookie is Secure.
COOKIE_SECURE=1
ROOM_TTL_SECONDS=7200
